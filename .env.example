# Q Studio configuration template.
#
# Q Studio reads these from the process environment; it does not load .env
# files itself. Copy to .env (gitignored) and export before launching:
#
#   set -a; source .env; set +a
#
# The API key can also be pasted in Settings, where it is stored in the
# macOS Keychain (or a 0600 secret.json if Keychain remembering is off).
# Precedence for the environment: QWEN_TOKEN_PLAN_KEY > DASHSCOPE_API_KEY.

# QwenCloud API key. Token Plan keys start with sk-sp- and only work against
# https://token-plan.maas.qwencloudapi.com (Singapore). Pay-as-you-go keys
# start with sk- or sk-ws- and use a region host chosen in Settings.
QWEN_TOKEN_PLAN_KEY=

# Fallback key variable, checked after QWEN_TOKEN_PLAN_KEY.
DASHSCOPE_API_KEY=

# API port. The Vite dev proxy reads the same value. Default: 8799.
#QSTUDIO_PORT=8799

# App-data directory (config, SQLite store, thumbnails).
# Default: ~/Library/Application Support/Q Studio on macOS, ~/.qstudio elsewhere.
#QSTUDIO_HOME=

# Bearer token required on /api routes. Generated per launch by the desktop
# app and the dev launcher; set it only if you run the engine yourself.
#QSTUDIO_TOKEN=

# macOS Keychain entry used to store the API key.
#QSTUDIO_KEYCHAIN_SERVICE=Q Studio
#QSTUDIO_KEYCHAIN_ACCOUNT=token-plan

# Explicit media-tool paths (default: resolved from PATH).
#QSTUDIO_FFMPEG=
#QSTUDIO_FFPROBE=

# Directory served in production mode (default: apps/web/dist).
#QSTUDIO_DIST=

# Engine log path surfaced in Settings (used by the desktop app).
#QSTUDIO_LOG=
